{
  "name": "brilliant-gems",
  "version": "1.0.0",
  "description": "《璀璨宝石》Windows 离线人机桌游",
  "main": "out/main/index.js",
  "type": "module",
  "author": "Local Player",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:assets": "node scripts/generate-assets.mjs",
    "build": "npm run build:assets && npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --win dir --x64"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/noto-sans-sc": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "boardgame.io": "^0.50.2",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.468.0",
    "png-to-ico": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.local.brilliantgems",
    "productName": "璀璨宝石",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "璀璨宝石-Portable-x64.exe"
    },
    "portable": {
      "artifactName": "璀璨宝石-Portable-x64.exe",
      "requestExecutionLevel": "user"
    }
  },
  "allowScripts": {
    "electron@43.2.0": true
  }
}
